    ##批量删除
    public function delQrlist(){
        $list = input('data');
        $list = explode(',',$list);
        if(Request::instance()->isAjax()){
            for($i = 0;$i<count($list);$i++){
                $ret = db('qrcode')->where('id',$list[$i])->delete();
            }
            if($ret){
                return ['status'=> 200];
            }else{
                return ['status'=> 202];
            }
        }
    }
