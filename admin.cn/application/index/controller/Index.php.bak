    //搜索
    public function searchContent(){
        $word = input('word');
        if(Request::instance()->isAjax()){
            $res = db('content')->where('uid|title', 'like','%'.$word.'%')->order('createtime desc')->select();
            if($res){
                $all = [];
                foreach ($res as $item){
                    $user = db('user')->where('uname',$item['uid'])->select();
                    $imgsid = explode(',',$item['imagesid']);
                    $img = db('source')->where('id',$imgsid[0])->value('url');
                    if($user){
                        $user = $user[0];
                        array_push($all,[
                            'uid'=> $user['uname'],
                            'nickname'=> $user['nickname'],
                            'cid'=> $item['id'],
                            'title'=> $item['title'],
                            'coverimg'=> $img,
                            'status'=> $item['status'],
                            'createtime'=> $item['createtime']
                        ]);
                    }
                }
                return ['status'=> 200, 'data'=> $all];
            }

        }
    }



    #---------##认证审核
    //返回认证数据   4类认证返回一样的数据
    public function verifylist(){
        $type = input('type');
        if(Session::get('admin_name')){
            switch ($type){
                case 'realname':
                    $identitylist=db('identity')
                        ->alias('i')
                        ->where('realname','<>','')
                        ->join('user u','u.uname=i.uid')
                        ->field(['i.uid','i.realname','i.idcard','i.idcardfront','i.idcardback','i.realnamestatus','u.nickname','u.phone'])
                        ->paginate(10);
                    $this->assign('identitylist',$identitylist);
                    return $this->fetch('realnamev'); break;
                case 'edu':
                    $identitylist=db('identity')
                        ->alias('i')
                        ->where('i.university','<>','')
                        ->join('user u','u.uname=i.uid')
                        ->field(['i.uid','i.education','i.university','i.educationimg','i.edustatus','u.nickname','u.phone'])
                        ->paginate(10);
                    $this->assign('identitylist',$identitylist);
                    return $this->fetch('eduv'); break;
                case 'job':
                    $identitylist=db('identity')
                        ->alias('i')
                        ->where('industry','<>','')
                        ->join('user u','u.uname=i.uid')
                        ->field(['i.uid','i.industry','i.companyname','i.duty','i.incomeinfo','i.jobimg','i.jobstatus','u.nickname','u.phone'])
                        ->paginate(10);
                    $this->assign('identitylist',$identitylist);
                    return $this->fetch('jobv'); break;
                case 'worth':
                    $identitylist=db('identity')
                        ->alias('i')
                        ->where('worth','<>','')
                        ->join('user u','u.uname=i.uid')
                        ->field(['i.uid','i.worth','i.worthimg','i.worthstatus','u.nickname','u.phone'])
                        ->paginate(10);
                    $this->assign('identitylist',$identitylist);
                    return $this->fetch('worthv'); break;
            }
        }else{
            return redirect('index');
        }
    }
    //发送验证短信   type:1注册 2验证码登录 3重置密码 4 认证 5.其他
    public function sendMsg($phone,$tid)
    {
        $phone = input('phone');
        //初始化必填
        //填写在开发者控制台首页上的Account Sid
        $options['accountsid'] = '220c478c5d21e7ebca85c7b4b2366d88';
        //填写在开发者控制台首页上的Auth Token
        $options['token'] = '312a8bc65fe9dc4ef76d10c0655bdafc';
        $ucpass = new Ucpaas($options);
        $appid = "8d0b2b4db2f5418287a3304a7606c4fd";    //应用的ID，可在开发者控制台内的短信产品下查看
        $templateid = $tid;    //可在后台短信产品→选择接入的应用→短信模板-模板ID，查看该模板ID
        $captcha = strval(rand(1000, 9999));
//        Cookie::set('captcha_' . $phone, $captcha, 360);
//        $param = $captcha; //多个参数使用英文逗号隔开（如：param=“a,b,c”），如为参数则留空
        $param = '';
        $mobile = $phone;
        $uid = "";
        return json([
            'status' => 200,
            'msg' => $ucpass->SendSms($appid, $templateid,$param, $mobile, $uid)
        ]);
    }
    //处理认证   4类统一用该方法，type区分
    public function doverify(){
        $uid = input('uid');
        $phone = input('phone');
        $type = input('type');
        $state = input('state');
        if(Request::instance()->isAjax()){
            switch ($type){
                case 'realname':
                    if($state == 1){
                        $ret = db('identity')->where('uid',$uid)->update([
                            'realnamestatus'=> 2  //审核通过
                        ]);
                        if($ret){
                            $distance = db('user')->where('uname',$uid)->value('distance');       ####-------------------------加距离操作
                            $much = db('distancerules')->where('when',3)->value('much');
                            db('user')->where('uname',$uid)->update(['distance'=>floatval($distance+$much)]);
                            $this->sendMsg($phone,'495498');
                            return ['status'=> 200];
                        }else{
                            return ['status'=> 202];
                        }
                    }else{
                        $ret = db('identity')->where('uid',$uid)->update([
                            'realname'=> '',
                            'idcard'=> '',
                            'idcardfront'=> '',
                            'idcardback'=> '',
                            'realnamestatus'=> 3
                        ]);
                        if($ret){
                            $this->sendMsg($phone,'495499');
                            return ['status'=> 200];
                        }else{
                            return ['status'=> 202];
                        }
                    }
                    break;
                case 'edu':
                    if($state == 1){
                        $ret = db('identity')->where('uid',$uid)->update([
                            'edustatus'=> 2  //审核通过
                        ]);
                        if($ret){
                            $distance = db('user')->where('uname',$uid)->value('distance');       ####-------------------------加距离操作
                            $much = db('distancerules')->where('when',3)->value('much');
                            db('user')->where('uname',$uid)->update(['distance'=>floatval($distance+$much)]);
                            $this->sendMsg($phone,'495498');
                            return ['status'=> 200];
                        }else{
                            return ['status'=> 202];
                        }
                    }else{
                        $ret = db('identity')->where('uid',$uid)->update([
                            'education'=> '',
                            'university'=> '',
                            'educationimg'=> '',
                            'edustatus'=> 3
                        ]);
                        if($ret){
                            $this->sendMsg($phone,'495499');
                            return ['status'=> 200];
                        }else{
                            return ['status'=> 202];
                        }
                    }
                    break;
                case 'job':
                    if($state == 1){
                        $ret = db('identity')->where('uid',$uid)->update([
                            'jobstatus'=> 2  //审核通过
                        ]);
                        if($ret){
                            $distance = db('user')->where('uname',$uid)->value('distance');       ####-------------------------加距离操作
                            $much = db('distancerules')->where('when',3)->value('much');
                            db('user')->where('uname',$uid)->update(['distance'=>floatval($distance+$much)]);
                            $this->sendMsg($phone,'495498');
                            return ['status'=> 200];
                        }else{
                            return ['status'=> 202];
                        }
                    }else{
                        $ret = db('identity')->where('uid',$uid)->update([
                            'industry'=> '',
                            'companyname'=> '',
                            'duty' => '',
                            'incomeinfo'=> '',
                            'jobimg'=> '',
                            'jobstatus'=> 3
                        ]);
                        if($ret){
                            $this->sendMsg($phone,'495499');
                            return ['status'=> 200];
                        }else{
                            return ['status'=> 202];
                        }
                    }
                    break;
                case 'worth':
                    if($state == 1){
                        $ret = db('identity')->where('uid',$uid)->update([
                            'worthstatus'=> 2  //审核通过
                        ]);
                        if($ret){
                            $distance = db('user')->where('uname',$uid)->value('distance');       ####-------------------------加距离操作
                            $much = db('distancerules')->where('when',3)->value('much');
                            db('user')->where('uname',$uid)->update(['distance'=>floatval($distance+$much)]);
                            $this->sendMsg($phone,'495498');
                            return ['status'=> 200];
                        }else{
                            return ['status'=> 202];
                        }
                    }else{
                        $ret = db('identity')->where('uid',$uid)->update([
                            'worth'=> '',
                            'worthimg'=> '',
                            'worthstatus'=> 3
                        ]);
                        if($ret){
                            $this->sendMsg($phone,'495499');
                            return ['status'=> 200];
                        }else{
                            return ['status'=> 202];
                        }
                    }
                    break;
            }
        }
    }
    ##搜索
    public function searchverify(){
        $word = input('word');
        $type = input('type');
        if(Request::instance()->isAjax()){
            switch ($type){
                case 'realname':
                    $res=db('identity')
                        ->alias('i')
                        ->where('uid',$word)
                        ->where('realname','<>','')
                        ->join('user u','u.uname=i.uid')
                        ->field(['i.uid','i.realname','i.idcard','i.idcardfront','i.idcardback','i.realnamestatus','u.nickname'])->select();
                    return ['status'=> 200, 'data'=> $res];
                    break;
                case 'edu':
                    $res=db('identity')
                        ->alias('i')
                        ->where('uid',$word)
                        ->where('realname','<>','')
                        ->join('user u','u.uname=i.uid')
                        ->field(['i.uid','i.education','i.university','i.educationimg','i.edustatus','u.nickname'])->select();
                    return ['status'=> 200, 'data'=> $res];
                    break;
                case 'job':
                    $res=db('identity')
                        ->alias('i')
                        ->where('uid',$word)
                        ->where('realname','<>','')
                        ->join('user u','u.uname=i.uid')
                        ->field(['i.uid','i.industry','i.companyname','i.duty','i.incomeinfo','i.jobimg','i.jobstatus','u.nickname'])
                        ->select();
                    return ['status'=> 200, 'data'=> $res];
                    break;
                case 'worth':
                    $res=db('identity')
                        ->alias('i')
                        ->where('uid',$word)
                        ->where('worth','<>','')
                        ->join('user u','u.uname=i.uid')
                        ->field(['i.uid','i.worth','i.worthimg','i.worthstatus','u.nickname'])
                        ->select();
                    return ['status'=> 200, 'data'=> $res];
                    break;
            }

        }
    }


