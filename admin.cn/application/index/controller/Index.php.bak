            $this->assign('user',$user);
            return $this->fetch('userInfo');
        }
    }
    //更新部分资料
    public function doupdate(){
        if(Session::get('admin_name')){
            $uid = input('uid');
            $nickname = input('nickname');
            $height = input('height');
            $weight = input('weight');
            $location = input('location');
            $job = input('job');
            $company = input('company');
            $income = input('income');
            $user = db('user')->where('uname',$uid)->select();
            if($user){
                $ret = db('user')->where('uname',$uid)->update([
                    'nickname'=> $nickname,
                    'height'=> $height,
                    'weight'=> $weight,
                    'location'=> $location,
                    'job'=> $job,
                    'company'=> $company,
                    'income'=> $income
                ]);
                if($ret){
                    return ['status'=> 200];
                }else{
                    return ['status'=> 202];
                }
            }else{
                return ['status'=> 404, 'msg'=> '用户不存在'];
            }
        }else{
            return redirect('index');
        }
    }
