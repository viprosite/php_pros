    //详情
    public function contentdetail(){
        $cid = input('cid');
            $all = [];
            $content = db('content')->where('id',$cid)->select();
            array_push($all,$content[0]);

            $imgsid = explode(',',$content[0]['imagesid']);
            $imgsurl = [];
            for($i=0;$i<count($imgsid);$i++){
                $coverimgurl = db('source')->where('id',$imgsid[$i])->value('url');
                $thumbnail = db('source')->where('id', $imgsid[$i])->value('thumbnail');
                if(strlen($thumbnail) != 0 && substr($thumbnail,-3) == 'mp4'){
                    array_push($imgsurl, ['cover'=>$coverimgurl, 'video'=> $thumbnail]);
                }else{
                    array_push($imgsurl, ['cover'=>$coverimgurl, 'video'=> '']);
                };
            }
            array_push($all, ['imgs'=>$imgsurl]);
            $contentuser = db('user')->where('uname',$content[0]['uid'])->select();
            if($contentuser){
                $contentuser = $contentuser[0];
            }
            array_push($all,$contentuser);
//            return json($all);
            $this->assign('content',$all);
            return $this->fetch();

    }
