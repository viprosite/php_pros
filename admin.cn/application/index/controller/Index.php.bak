    ###其他信息更新
    public function updateOtherinfo(){
        if(Request::instance()->isAjax()){
            $type = input('type');
            $nval = input('newv');
            switch ($type){
                case 'website':
                    $ret = db('otherinfo')->where('id',1)->update(['website'=> $nval]);
                    break;
                case 'email':
                    $ret = db('otherinfo')->where('id',1)->update(['email'=> $nval]);
                    break;
                case 'phone':
                    $ret = db('otherinfo')->where('id',1)->update(['phone'=> $nval]);
                    break;
            }
            if($ret){
                return ['status'=> 200];
            }else{
                return ['status'=> 202];
            }
        }
    }

    //1、隐私政策，2、用户协议

    public function Administration(){
        if(Request::instance()->isAjax()){
            $data = ['content'=>input('content')];
            $update = db('privacy')->where('id',input('id'))->update($data);
            if($update){
                return 1;
            }
        }
        $id = input('id');
        $find = db('privacy')->where('id',$id)->find();
        $this->assign('privacy',$find);
        return $this->fetch('Administration');
     }    


