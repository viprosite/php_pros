    ###二维码
    ###返回最后一条记录的number
    public function retnum(){
        $res = db('qrcode')->order('number desc')->limit(1)->value('number');
        if($res){
            return json([
                'number'=> $res
            ]);
        }else{
            return json([
                'number'=> 0
            ]);
        }
    }

    ###保存生成的二维码信息
    public function generateQrcode(){
        $number = input('number');
        $token = input('token');
        if($number == ''){
            return json([
                'status'=> 201,
                'msg'=> 'number参数为空'
            ]);
        }
        if(count($number) == count($token)){
            $number = explode(',', $number);
//            return json($number);
            $token = explode(',', $token);
//            return json(trim($number[0],'"'));
            for($i=0;$i<count($number);$i++){
                $ret = db('qrcode')->where(['number' => intval($number[$i]), 'token' => $token[$i]])->count();
                if ($ret == 0) {
                    $res = db('qrcode')->insert([
                        'number' => intval($number[$i]),
                        'token' => $token[$i],
                        'createtime' => date('Y-m-d H:i:s')
                    ]);
                } else {
                    return json([
                        'status' => 203,
                        'msg' => '早前已经生成该二维码'
                    ]);
                }
            }
            if ($res) {
                return json([
                    'status' => 200,
                    'msg' => 'ok',
                    'data'=> [
                        'numbers'=> $number,
                        'tokens'=> $token
                    ]
                ]);
            } else {
                return json([
                    'status' => 202,
                    'msg' => 'failed'
                ]);
            }
        }else{
            return json([
                'status'=> 202,
                'msg'=> '发生错误'
            ]);
        }
    }
