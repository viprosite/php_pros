    public function doadda(){
        $version = input('version');
        $type = input('type');
        $tool = new Tools();
        $res = db('appinfo')->where('version', $version)->select();
        if($res){
            if($type == 'a'){
                $aurl = $_FILES['afile'];
                $status = $tool->fileuploader($aurl,ROOT_PATH."public/uploads/app/".date("Y-m-d")."/");
                if($status['status'] == 1){
                    $ret = db('appinfo')->where('version',$version)->update(['androidurl'=> $status['fileurl'],'createtime'=> date('Y-m-d H:i:s')]);
                    if ($ret){
                        return ['status'=> 200];
                    }else{
                        return ['status'=> 202];
                    }
                }else{
                    return ['status'=> 203, 'msg'=> 'android包上传失败'];
                }
            }else{
                $iurl = $_FILES['ifile'];
                $status = $tool->fileuploader($iurl,ROOT_PATH."public/uploads/app/".date("Y-m-d")."/");
                if($status['status'] == 1){
                    $ret = db('appinfo')->where('version',$version)->update(['iosurl'=> $status['fileurl'],'createtime'=> date('Y-m-d H:i:s')]);
                    if ($ret){
                        return ['status'=> 200];
                    }else{
                        return ['status'=> 202];
                    }
                }else{
                    return ['status'=> 203, 'msg'=> 'ios包上传失败'];
                }
            }
        }else{
            if($type == 'a'){
                $aurl = $_FILES['afile'];
                $status = $tool->fileuploader($aurl,ROOT_PATH."public/uploads/app/".date("Y-m-d")."/");
                if($status['status'] == 1){
                    $ret = db('appinfo')->where('version',$version)->insert(['version'=> $version,'androidurl'=> $status['fileurl'],'createtime'=> date('Y-m-d H:i:s')]);
                    if ($ret){
                        return ['status'=> 200];
                    }else{
                        return ['status'=> 202];
                    }
                }else{
                    return ['status'=> 203, 'msg'=> 'android包上传失败'];
                }
            }else{
                $iurl = $_FILES['ifile'];
                $status = $tool->fileuploader($iurl,ROOT_PATH."public/uploads/app/".date("Y-m-d")."/");
                if($status['status'] == 1){
                    $ret = db('appinfo')->where('version',$version)->update(['version'=> $version,'iosurl'=> $status['fileurl'],'createtime'=> date('Y-m-d H:i:s')]);
                    if ($ret){
                        return ['status'=> 200];
                    }else{
                        return ['status'=> 202];
                    }
                }else{
                    return ['status'=> 203, 'msg'=> 'ios包上传失败'];
                }
            }
        }
    }

