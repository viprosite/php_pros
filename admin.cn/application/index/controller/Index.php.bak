    //doadduser
    public function doadduser(){
        $uname = $this->generateuname();
        $pwd = input('pwd');
        $nickname = input('nickname');
        $sex = input('sex');
        $birthday = input('birthday');
        $ret = db('user')->insert([
            'uname'=> $uname,
            'pwd'=> $pwd,
            'nickname'=> $nickname,
            'sex'=> $sex,
            'birthday'=> $birthday,
            'createtime'=> date('Y-m-d H:i:s'),
            'lastip'=> Request::instance()->ip(),
        ]);
        if($ret){
            return ['status'=> 200];
        }else{
            return ['status'=> 202];
        }
    }
    //搜索
    public function searchuser(){
        $word = input('word');
        if(Request::instance()->isAjax()){
            $res = db('user')->where('uname|nickname', 'like',$word)->select();
            return ['status'=> 200, 'data'=> $res];
        }
    }
    //用户冻结与启用
    public function changeUserStatue(){
        $uid = input('uid');
        if(Request::instance()->isAjax()){
            $userstatue = db('user')->where('uname',$uid)->value('status');
            if($userstatue == 1){
                $ret = db('user')->where('uname',$uid)->setField('status',0);
            }else{
                $ret = db('user')->where('uname',$uid)->setField('status',1);
            }
            if($ret){
                return ['status'=> 200];
            }else{
                return ['status'=> 202];
            }
        }
    }
